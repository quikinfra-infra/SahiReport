    style FrontendUI fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px
    style CoreServices fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    style DataLayer fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    style ExternalIntegrations fill:#fce4ec,stroke:#e91e63,stroke-width:2px